{
  "name": "meu-app",
  "version": "0.0.0",
  "description": "Plataforma imobiliária Angular 22 com SSR para compra e aluguel de imóveis em todo o Brasil",
  "author": "Matheus Moraes",
  "license": "MIT",
  "homepage": "https://meu-app-kohl-mu.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MTconnect-BR/meu-app.git"
  },
  "bugs": {
    "url": "https://github.com/MTconnect-BR/meu-app/issues"
  },
  "scripts": {
    "start": "nx serve meu-app",
    "build": "nx build meu-app",
    "watch": "nx build meu-app --watch --configuration development",
    "test": "nx test meu-app",
    "serve:ssr:meu-app": "node dist/meu-app/server/server.mjs",
    "lint": "nx lint meu-app",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css}\"",
    "dead-code": "knip",
    "analyze": "source-map-explorer dist/meu-app/browser/*.js",
    "test:coverage": "nx test meu-app -- --coverage",
    "size-limit": "size-limit"
  },
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@angular/animations": "^22.0.4",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/platform-browser": "^22.0.4",
    "@angular/platform-server": "^22.0.4",
    "@angular/router": "^22.0.4",
    "@angular/ssr": "^22.0.4",
    "@bluehalo/ngx-leaflet": "^22.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@ng-icons/core": "^33.3.0",
    "@ng-icons/lucide": "^33.3.0",

    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",

    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",

    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.0.4",
    "@angular-devkit/schematics": "^22.0.4",
    "@angular-eslint/builder": "22.0.0",
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.0.1",
    "@nx/eslint": "^23.0.1",
    "@nx/workspace": "23.0.1",
    "@schematics/angular": "^22.0.4",
    "@size-limit/file": "^12.1.0",

    "@tailwindcss/postcss": "^4.3.2",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "22.0.0",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.23.0",
    "nx": "23.0.2",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "size-limit": "^12.1.0",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
<Window
    x:Class="CRM_Alunos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CRM_Alunos"
    xmlns:pages="using:CRM_Alunos.Pages"
    Title="CRM Alunos - Gestão de Turmas"
    Width="1400" Height="800" MinWidth="1000" MinHeight="600"
    Background="#F8F9FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#1E1E2E">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo/App Title -->
            <Border Grid.Row="0" Padding="20,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="#818CF8"/>
                    <TextBlock Text="CRM Alunos" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Navigation -->
            <ListView x:Name="NavListView" Grid.Row="1"
                      SelectionChanged="NavListView_SelectionChanged"
                      Padding="8,8" SelectionMode="Single"
                      Background="Transparent">
                <ListViewItem x:Name="NavDashboard" Tag="Dashboard" Padding="12,10" Margin="0,2" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE80F;" FontSize="18" Foreground="#94A3B8"/>
                        <TextBlock Text="Dashboard" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="NavTurmas" Tag="Turmas" Padding="12,10" Margin="0,2" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B4;" FontSize="18" Foreground="#94A3B8"/>
                        <TextBlock Text="Turmas" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="NavAlunos" Tag="Alunos" Padding="12,10" Margin="0,2" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="#94A3B8"/>
                        <TextBlock Text="Alunos" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
                <ListViewItem x:Name="NavDocumentos" Tag="Documentos" Padding="12,10" Margin="0,2" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="#94A3B8"/>
                        <TextBlock Text="Documentos" Foreground="#CBD5E1" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListViewItem>
            </ListView>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="20,16" BorderBrush="#334155" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="#64748B"/>
                    <TextBlock Text="Usuário Local" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content -->
        <Frame x:Name="ContentFrame" Grid.Column="1" Background="#F8F9FA"/>
    </Grid>
</Window>

<Window
    x:Class="CRM_Alunos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:CRM_Alunos.Pages"
    Title="CRM Alunos"
    Width="1400" Height="800"
    MinWidth="1000" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResizeWithGrip"
    Background="#F1F5F9">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E293B">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Height="64" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Margin="0,0,12,0" Foreground="#818CF8" VerticalAlignment="Center"/>
                        <TextBlock Text="CRM Alunos" FontSize="18" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Padding="20,16"
                        BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Margin="0,0,10,0" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock Text="Usuário Local" Foreground="#64748B"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Buttons -->
                <StackPanel Margin="8,8">
                    <Button x:Name="BtnDashboard" Style="{StaticResource NavButtonStyle}"
                            Click="BtnDashboard_Click" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnTurmas" Style="{StaticResource NavButtonStyle}"
                            Click="BtnTurmas_Click" Tag="Turmas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE805;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Turmas" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnAlunos" Style="{StaticResource NavButtonStyle}"
                            Click="BtnAlunos_Click" Tag="Alunos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Alunos" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDocumentos" Style="{StaticResource NavButtonStyle}"
                            Click="BtnDocumentos_Click" Tag="Documentos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Documentos" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Background="#334155" Margin="8,8"/>
                    <Button x:Name="BtnConfiguracoes" Style="{StaticResource NavButtonStyle}"
                            Click="BtnConfiguracoes_Click" Tag="Configuracoes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Configuracoes" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl x:Name="ContentFrame" Grid.Column="1" Background="#F1F5F9"/>
    </Grid>
</Window>

<Page
    x:Class="CRM_Alunos.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center">
            <!-- Header -->
            <TextBlock Text="Dashboard" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
            <TextBlock Text="Visão geral do sistema de gestão de turmas e alunos" FontSize="14" Foreground="#64748B" Margin="0,0,0,32"/>
            
            <!-- Stats Cards -->
            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.ColumnSpacing="20">
                    <!-- Turmas Card -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="#E2E8F0">
                        <StackPanel>
                            <FontIcon Glyph="&#xE8B4;" FontSize="28" Foreground="#818CF8" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtTurmasCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Turmas" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Alunos Card -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="#E2E8F0">
                        <StackPanel>
                            <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="#34D399" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtAlunosCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Alunos" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Documentos Card -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="#E2E8F0">
                        <StackPanel>
                            <FontIcon Glyph="&#xE8A5;" FontSize="28" Foreground="#F59E0B" Margin="0,0,0,12"/>
                            <TextBlock x:Name="TxtDocsCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Documentos" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid.ColumnSpacing>
            </Grid>
            
            <!-- Recent Activity -->
            <Border Background="White" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="#E2E8F0">
                <StackPanel>
                    <TextBlock Text="Atividade Recente" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
                    <TextBlock x:Name="TxtNoActivity" Text="Nenhuma atividade recente" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <ListView x:Name="ActivityList" Visibility="Collapsed" Background="Transparent">
                        <!-- Activity items populated dynamically -->
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
<UserControl x:Class="CRM_Alunos.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F1F5F9">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Welcome -->
        <TextBlock Grid.Row="0" Text="Bem-vindo ao CRM de Alunos" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>

        <!-- Stats Cards -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Turmas Card -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Turmas" FontSize="14" Foreground="#64748B"/>
                    <TextBlock x:Name="TurmasCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#6366F1" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Alunos Card -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Alunos" FontSize="14" Foreground="#64748B"/>
                    <TextBlock x:Name="AlunosCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#6366F1" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Documentos Card -->
            <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Documentos" FontSize="14" Foreground="#64748B"/>
                    <TextBlock x:Name="DocumentosCount" Text="0" FontSize="36" FontWeight="Bold" Foreground="#6366F1" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recent Activity -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Atividade Recente" FontSize="18" FontWeight="SemiBold"
                           Foreground="#1E293B" Margin="0,0,0,16"/>
                <ListView x:Name="LvActivity" BorderThickness="0" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#6366F1" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

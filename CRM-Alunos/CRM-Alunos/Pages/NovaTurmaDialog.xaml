<Window x:Class="CRM_Alunos.Pages.NovaTurmaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Turma" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nova Turma" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Nome:" VerticalAlignment="Center" Width="80" Foreground="#64748B"/>
            <TextBox x:Name="TxtNome" Width="280" Padding="8,6" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Período:" VerticalAlignment="Center" Width="80" Foreground="#64748B"/>
            <ComboBox x:Name="CboPeriodo" Width="280" Padding="8,6" FontSize="14">
                <ComboBoxItem Content="Manhã"/>
                <ComboBoxItem Content="Tarde"/>
                <ComboBoxItem Content="Noite"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <TextBlock Text="Horário:" VerticalAlignment="Center" Width="80" Foreground="#64748B"/>
            <TextBox x:Name="TxtHorario" Width="280" Padding="8,6" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <TextBlock Text="Sala:" VerticalAlignment="Center" Width="80" Foreground="#64748B"/>
            <TextBox x:Name="TxtSala" Width="280" Padding="8,6" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Salvar" Background="#6366F1" Foreground="White" BorderThickness="0"
                    Padding="20,8" Cursor="Hand" Click="BtnSalvar_Click" IsDefault="True">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancelar" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0"
                    Padding="20,8" Cursor="Hand" Click="BtnCancelar_Click" IsCancel="True" Margin="8,0,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>

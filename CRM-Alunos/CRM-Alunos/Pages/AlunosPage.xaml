<Page
    x:Class="CRM_Alunos.Pages.AlunosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Alunos" FontSize="32" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="PageSubtitle" Text="Gerencie todos os alunos cadastrados" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="BtnVoltar" Content="Voltar" Click="BtnVoltar_Click"
                            Background="Transparent" Foreground="#4F46E5" Padding="16,10" CornerRadius="8"
                            BorderBrush="#4F46E5" BorderThickness="1" VerticalVisibility="Collapsed"/>
                    <Button x:Name="BtnNovoAluno" Click="BtnNovoAluno_Click"
                            Background="#4F46E5" Foreground="White" Padding="20,10" CornerRadius="8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White"/>
                            <TextBlock Text="Novo Aluno" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Filters -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="8" Padding="4" BorderThickness="1" BorderBrush="#E2E8F0">
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Pesquisar alunos..." QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged" Margin="8,4"/>
                </Border>
                <ComboBox x:Name="FilterTurma" Grid.Column="1" PlaceholderText="Filtrar por turma"
                          SelectionChanged="FilterTurma_SelectionChanged" Margin="12,0,0,0"
                          Background="White" BorderBrush="#E2E8F0" CornerRadius="8"/>
            </Grid>
            
            <!-- Alunos Table -->
            <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#E2E8F0">
                <Grid>
                    <!-- Header -->
                    <Grid Padding="20,12" Background="#F8FAFC">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nome" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="CPF" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="Telefone" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="Turma" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="5" Text="Matrícula" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                    </Grid>
                    
                    <ListView x:Name="AlunosListView" Grid.Row="1" SelectionMode="None" Background="Transparent"/>
                    
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40" Visibility="Visible">
                        <FontIcon Glyph="&#xE77B;" FontSize="48" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhum aluno encontrado" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<UserControl x:Class="CRM_Alunos.Pages.AlunosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F1F5F9">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="Alunos" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Gerencie os alunos do sistema" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnNovoAluno" Content="+ Novo Aluno" HorizontalAlignment="Right"
                    Background="#6366F1" Foreground="White" BorderThickness="0"
                    Padding="16,8" Cursor="Hand" Click="BtnNovoAluno_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <!-- Filters -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
            <DockPanel>
                <TextBlock Text="Filtrar por turma:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                <ComboBox x:Name="CboTurmas" Width="200" DisplayMemberPath="Nome"
                          SelectionChanged="CboTurma_SelectionChanged"/>
                <TextBox x:Name="TxtSearch" BorderThickness="0" Padding="8" FontSize="14"
                         Width="250" HorizontalAlignment="Right" Background="Transparent"
                         KeyUp="TxtSearch_KeyUp"/>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="6" x:Name="DgAlunos" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" BorderThickness="0" Background="White"
                  RowBackground="White" AlternatingRowBackground="#F1F5F9"
                  GridLinesVisibility="None" SelectionMode="Single"
                  MouseDoubleClick="DgAlunos_MouseDoubleClick"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="CPF" Binding="{Binding CPF}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="140"/>
                <DataGridTextColumn Header="Turma" Binding="{Binding Turma.Nome}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Add/Edit Panel -->
        <Border Grid.Row="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Nome:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtNome" Width="180" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="CPF:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtCPF" Width="140" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Email:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtEmail" Width="180" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Telefone:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtTelefone" Width="120" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Turma:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <ComboBox x:Name="CboTurmaEdit" Width="150" Padding="8,6"
                              DisplayMemberPath="Nome" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <ComboBox x:Name="CboStatus" Width="120" Padding="8,6" VerticalAlignment="Center">
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>
                        <ComboBoxItem Content="Formado"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="Salvar" Background="#6366F1" Foreground="White" BorderThickness="0"
                        Padding="16,6" Cursor="Hand" Margin="0,0,8,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Cancelar" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0"
                        Padding="16,6" Cursor="Hand" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>

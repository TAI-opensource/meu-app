<UserControl x:Class="CRM_Alunos.Pages.ConfiguracoesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F1F5F9">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Configuracoes" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>

        <!-- Update Card -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Atualizacoes" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock x:Name="LblVersion" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                    <TextBlock x:Name="LblUpdateStatus" FontSize="13" Foreground="#64748B" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCheckUpdate" Content="Verificar Atualizacoes" Background="#6366F1" Foreground="White"
                            BorderThickness="0" Padding="16,8" Cursor="Hand" Click="BtnCheckUpdate_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnInstallUpdate" Content="Instalar Atualizacao" Background="#10B981" Foreground="White"
                            BorderThickness="0" Padding="16,8" Cursor="Hand" Margin="8,0,0,0" Visibility="Collapsed"
                            Click="BtnInstallUpdate_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#059669"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Progress Bar -->
        <Border x:Name="ProgressBorder" Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="12" Padding="24" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="LblProgress" Text="Progresso..." FontSize="14" Foreground="#64748B" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBar" Height="8" Background="#E2E8F0" Foreground="#6366F1"
                             BorderThickness="0" Maximum="100"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

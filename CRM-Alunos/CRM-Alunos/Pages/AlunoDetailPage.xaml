<UserControl x:Class="CRM_Alunos.Pages.AlunoDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F1F5F9">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <Button x:Name="BtnVoltar" Content="&#xE72B; Voltar" Background="Transparent" Foreground="#6366F1"
                    BorderThickness="0" Padding="8,4" Cursor="Hand" Click="BtnVoltar_Click" FontSize="14">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="PageTitle" Text="Detalhes do Aluno" FontSize="28" FontWeight="Bold"
                       Foreground="#1E293B" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button x:Name="BtnEditar" Content="Editar" HorizontalAlignment="Right"
                    Background="#6366F1" Foreground="White" BorderThickness="0"
                    Padding="16,8" Cursor="Hand" FontSize="14" Click="BtnEditar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Personal Info Card -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Informações Pessoais" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E293B" Margin="0,0,0,16"/>

                    <TextBlock Text="Nome" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="LblNome" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="CPF" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="LblCPF" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="Email" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="LblEmail" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="Telefone" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="LblTelefone" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="Endereço" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="LblEndereco" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <TextBlock Text="Turma" FontSize="12" Foreground="#64748B"/>
                    <TextBlock x:Name="LblTurma" FontSize="16" Foreground="#1E293B"/>
                </StackPanel>
            </Border>

            <!-- Documents Panel -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24">
                <DockPanel>
                    <!-- Document Actions -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="BtnNovoDocumento" Content="+ Novo Documento" Background="#6366F1" Foreground="White"
                                BorderThickness="0" Padding="12,8" Cursor="Hand" Margin="0,0,8,0" Click="BtnUpload_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnNovaPasta" Content="+ Nova Pasta" Background="#10B981" Foreground="White"
                                BorderThickness="0" Padding="12,8" Cursor="Hand" Click="BtnNovaPasta_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#059669"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnExcluir" Content="Excluir" Background="#FEE2E2" Foreground="#DC2626"
                                BorderThickness="0" Padding="12,8" Cursor="Hand" Click="BtnExcluir_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FECACA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Documentos" FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E293B" Margin="0,0,0,12"/>

                    <!-- Documents List -->
                    <DataGrid x:Name="DgDocumentos" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" BorderThickness="0" Background="White"
                              RowBackground="White" AlternatingRowBackground="#F1F5F9"
                              GridLinesVisibility="None" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                            <DataGridTextColumn Header="Pasta" Binding="{Binding Pasta.Nome}" Width="120"/>
                            <DataGridTextColumn Header="Data Upload" Binding="{Binding DataUpload, StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding Tamanho}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Page
    x:Class="CRM_Alunos.Pages.AlunoDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center">
            <!-- Back Button -->
            <Button x:Name="BtnVoltar" Click="BtnVoltar_Click" Background="Transparent" 
                    Foreground="#4F46E5" Padding="8,6" Margin="-8,0,0,16" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock Text="Voltar" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            <!-- Student Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Avatar -->
                <Border Width="72" Height="72" CornerRadius="36" Background="#E0E7FF" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE77B;" FontSize="32" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <!-- Name and status -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNome" Text="Carregando..." FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Border x:Name="StatusBadge" CornerRadius="12" Padding="10,4">
                            <TextBlock x:Name="TxtStatus" Text="Ativo" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="TxtTurma" Text="" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Edit Button -->
                <Button Grid.Column="2" x:Name="BtnEditar" Click="BtnEditar_Click"
                        Background="Transparent" Foreground="#4F46E5" Padding="16,8" CornerRadius="8"
                        BorderBrush="#4F46E5" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                        <TextBlock Text="Editar"/>
                    </StackPanel>
                </Button>
            </Grid>
            
            <!-- Two Column Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="500"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.ColumnSpacing="24">
                    
                    <!-- Left: Student Info -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="#E2E8F0">
                        <StackPanel>
                            <TextBlock Text="Informações Pessoais" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16"/>
                            
                            <StackPanel Spacing="14">
                                <StackPanel>
                                    <TextBlock Text="CPF" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtCPF" Text="-" FontSize="14" Foreground="#1E293B" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Email" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtEmail" Text="-" FontSize="14" Foreground="#1E293B" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Telefone" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtTelefone" Text="-" FontSize="14" Foreground="#1E293B" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Data de Nascimento" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtNascimento" Text="-" FontSize="14" Foreground="#1E293B" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Endereço" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtEndereco" Text="-" FontSize="14" Foreground="#1E293B" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Data de Matrícula" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtMatricula" Text="-" FontSize="14" Foreground="#1E293B" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Observações" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtObs" Text="-" FontSize="14" Foreground="#1E293B" FontWeight="Medium" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Right: Documents -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24" BorderThickness="1" BorderBrush="#E2E8F0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Documentos" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="BtnNovaPasta" Click="BtnNovaPasta_Click"
                                            Background="Transparent" Foreground="#4F46E5" Padding="10,6" CornerRadius="6"
                                            BorderBrush="#4F46E5" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                                            <TextBlock Text="Pasta" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnUpload" Click="BtnUpload_Click"
                                            Background="#4F46E5" Foreground="White" Padding="10,6" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE898;" FontSize="12" Foreground="White"/>
                                            <TextBlock Text="Upload" FontSize="12" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Folders -->
                            <ListView x:Name="FoldersList" Background="Transparent" Margin="0,0,0,12"/>
                            
                            <!-- Documents List -->
                            <ListView x:Name="DocumentsList" Background="Transparent"/>
                            
                            <!-- Empty state -->
                            <StackPanel x:Name="EmptyDocs" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">
                                <FontIcon Glyph="&#xE8A5;" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nenhum documento" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="Faça upload de PDFs e documentos" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid.ColumnSpacing>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

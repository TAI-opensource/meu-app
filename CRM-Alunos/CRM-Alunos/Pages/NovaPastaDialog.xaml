<Window x:Class="CRM_Alunos.Pages.NovaPastaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Pasta" Height="160" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nome da Pasta" FontSize="14" FontWeight="SemiBold"
                   Foreground="#1E293B"/>

        <TextBox x:Name="TxtNomePasta" Grid.Row="2" FontSize="14" Padding="8"
                 BorderBrush="#E2E8F0" BorderThickness="1"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Padding="16,8" Margin="0,0,8,0"
                    Background="#F1F5F9" Foreground="#64748B" BorderThickness="0"
                    Cursor="Hand" Click="BtnCancelar_Click"/>
            <Button Content="Criar" Padding="16,8"
                    Background="#6366F1" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="BtnCriar_Click"/>
        </StackPanel>
    </Grid>
</Window>

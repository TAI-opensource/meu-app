<UserControl x:Class="CRM_Alunos.Pages.TurmasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F1F5F9">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Turmas" FontSize="28" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Gerencie as turmas do sistema" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnNovaTurma" Content="+ Nova Turma" HorizontalAlignment="Right"
                    Background="#6366F1" Foreground="White" BorderThickness="0"
                    Padding="16,8" Cursor="Hand" Click="BtnNovaTurma_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DockPanel>

        <!-- Search -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4">
            <TextBox x:Name="TxtSearch" BorderThickness="0" Padding="8" FontSize="14"
                     Background="Transparent" KeyUp="TxtSearch_KeyUp"/>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="6" x:Name="DgTurmas" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" BorderThickness="0" Background="White"
                  RowBackground="White" AlternatingRowBackground="#F1F5F9"
                  GridLinesVisibility="None" SelectionMode="Single"
                  MouseDoubleClick="DgTurmas_MouseDoubleClick"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="120"/>
                <DataGridTextColumn Header="Horário" Binding="{Binding Horario}" Width="120"/>
                <DataGridTextColumn Header="Sala" Binding="{Binding Sala}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Add/Edit Panel -->
        <Border Grid.Row="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Nome:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtNome" Width="180" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Periodo:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtPeriodo" Width="120" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Horario:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtHorario" Width="120" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Sala:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBox x:Name="TxtSala" Width="80" Padding="8,6" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <ComboBox x:Name="CboStatus" Width="120" Padding="8,6" VerticalAlignment="Center">
                        <ComboBoxItem Content="Ativa"/>
                        <ComboBoxItem Content="Inativa"/>
                        <ComboBoxItem Content="Concluida"/>
                    </ComboBox>
                </StackPanel>

                <Button Content="Salvar" Background="#6366F1" Foreground="White" BorderThickness="0"
                        Padding="16,6" Cursor="Hand" Margin="0,0,8,8" Click="BtnSalvarInline_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4F46E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Cancelar" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0"
                        Padding="16,6" Cursor="Hand" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>

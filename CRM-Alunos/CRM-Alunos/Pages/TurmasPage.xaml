<Page
    x:Class="CRM_Alunos.Pages.TurmasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,32">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center">
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Turmas" FontSize="32" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="Gerencie todas as turmas cadastradas" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnNovaTurma" Content="Nova Turma" Click="BtnNovaTurma_Click"
                        Background="#4F46E5" Foreground="White" Padding="20,10" CornerRadius="8"
                        FontWeight="SemiBight" VerticalAlignment="Center">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White"/>
                            <TextBlock Text="Nova Turma" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
            
            <!-- Search -->
            <Border Background="White" CornerRadius="8" Padding="4" BorderThickness="1" BorderBrush="#E2E8F0" Margin="0,0,0,20">
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Pesquisar turmas..." QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged" Margin="8,4"/>
            </Border>
            
            <!-- Turmas Table -->
            <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#E2E8F0">
                <Grid>
                    <!-- Header Row -->
                    <Grid Padding="20,12" Background="#F8FAFC">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nome" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="Ano Letivo" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="Série" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="3" Text="Alunos" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                        <TextBlock Grid.Column="4" Text="Criada em" FontWeight="SemiBold" Foreground="#475569" FontSize="13"/>
                    </Grid>
                    
                    <!-- Data Rows -->
                    <ListView x:Name="TurmasListView" Grid.Row="1" SelectionMode="None" 
                              Background="Transparent" ItemClick="TurmasListView_ItemClick"
                              IsItemClickEnabled="True" Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <!-- Placeholder -->
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                        <FontIcon Glyph="&#xE8B4;" FontSize="48" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhuma turma encontrada" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="Clique em 'Nova Turma' para criar a primeira turma" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

@page "/alunos"
@using CRM_Alunos.Web.Data
@using CRM_Alunos.Web.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IDebugService DebugService

<PageTitle>Alunos - CRM Alunos</PageTitle>

<div class="tw-page-header">
    <h1 class="tw-page-title">Alunos</h1>
    <button class="tw-btn tw-btn-primary" @onclick="OpenCreateDialog">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Novo Aluno
    </button>
</div>

<div class="tw-filter-bar">
    <input @bind="searchText" @bind:event="oninput" @onkeyup="FilterAlunos" placeholder="Buscar por nome..." class="tw-input" style="flex: 1; max-width: 320px;" />
    <select @bind="filterTurmaId" @bind:after="FilterAlunos" class="tw-input" style="width: 180px;">
        <option value="0">Todas as turmas</option>
        @foreach (var t in turmas)
        {
            <option value="@t.Id">@t.Nome</option>
        }
    </select>
</div>

<div class="tw-table-container">
    <table class="tw-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>CPF</th>
                <th>Email</th>
                <th>Turma</th>
                <th>Status</th>
                <th style="width: 80px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var aluno in filteredAlunos)
            {
                <tr @onclick="() => ViewAluno(aluno.Id)" style="cursor: pointer;">
                    <td style="font-weight: 500;">@aluno.Nome</td>
                    <td>@aluno.CPF</td>
                    <td>@aluno.Email</td>
                    <td>@aluno.Turma?.Nome</td>
                    <td>
                        <span class="tw-badge @(aluno.Status == "Ativo" ? "tw-badge-success" : aluno.Status == "Formado" ? "tw-badge-neutral" : "tw-badge-danger")">@aluno.Status</span>
                    </td>
                    <td @onclick:stopPropagation="true">
                        <div style="display: flex; gap: 4px;">
                            <button class="tw-btn tw-btn-ghost tw-btn-sm" @onclick="() => OpenEditDialog(aluno)" title="Editar">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            </button>
                            <button class="tw-btn tw-btn-danger tw-btn-sm" @onclick="() => OpenDeleteDialog(aluno)" title="Excluir">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!filteredAlunos.Any())
    {
        <div class="tw-empty">
            <svg class="tw-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <p>Nenhum aluno encontrado</p>
        </div>
    }
</div>

@if (showDialog)
{
    <div class="tw-dialog-overlay" @onclick="CloseDialog">
        <div class="tw-dialog" style="width: 560px;" @onclick:stopPropagation="true">
            <div class="tw-dialog-header">@(editingAluno.Id > 0 ? "Editar Aluno" : "Novo Aluno")</div>
            <div class="tw-dialog-body">
                <div class="tw-form-row">
                    <div class="tw-form-group">
                        <label class="tw-form-label">Nome *</label>
                        <input @bind="editingAluno.Nome" class="tw-input" />
                    </div>
                    <div class="tw-form-group">
                        <label class="tw-form-label">CPF</label>
                        <input @bind="editingAluno.CPF" class="tw-input" />
                    </div>
                    <div class="tw-form-group">
                        <label class="tw-form-label">Email</label>
                        <input @bind="editingAluno.Email" class="tw-input" />
                    </div>
                    <div class="tw-form-group">
                        <label class="tw-form-label">Telefone</label>
                        <input @bind="editingAluno.Telefone" class="tw-input" />
                    </div>
                    <div class="tw-form-group">
                        <label class="tw-form-label">Endereço</label>
                        <input @bind="editingAluno.Endereco" class="tw-input" />
                    </div>
                    <div class="tw-form-group">
                        <label class="tw-form-label">Data de Nascimento</label>
                        <input @bind="editingAluno.DataNascimento" type="date" class="tw-input" />
                    </div>
                    <div class="tw-form-group">
                        <label class="tw-form-label">Turma *</label>
                        <select @bind="editingAluno.TurmaId" class="tw-input">
                            <option value="0">Selecione a Turma</option>
                            @foreach (var t in turmas)
                            {
                                <option value="@t.Id">@t.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="tw-form-group">
                        <label class="tw-form-label">Status</label>
                        <select @bind="editingAluno.Status" class="tw-input">
                            <option value="Ativo">Ativo</option>
                            <option value="Inativo">Inativo</option>
                            <option value="Formado">Formado</option>
                        </select>
                    </div>
                </div>
                <div class="tw-form-group">
                    <label class="tw-form-label">Observações</label>
                    <textarea @bind="editingAluno.Observacoes" class="tw-input" style="min-height: 60px; resize: vertical;"></textarea>
                </div>
            </div>
            <div class="tw-dialog-footer">
                <button class="tw-btn tw-btn-secondary" @onclick="CloseDialog">Cancelar</button>
                <button class="tw-btn tw-btn-primary" @onclick="SaveAluno">Salvar</button>
            </div>
        </div>
    </div>
}

@if (showDeleteDialog)
{
    <div class="tw-dialog-overlay" @onclick="CloseDeleteDialog">
        <div class="tw-dialog" style="width: 400px;" @onclick:stopPropagation="true">
            <div class="tw-dialog-header">Excluir Aluno</div>
            <div class="tw-dialog-body">
                <p style="font-size: 13px; color: var(--twenty-text-secondary);">
                    Tem certeza que deseja excluir o aluno <strong>@alunoToDelete?.Nome</strong>? Esta ação não pode ser desfeita.
                </p>
            </div>
            <div class="tw-dialog-footer">
                <button class="tw-btn tw-btn-secondary" @onclick="CloseDeleteDialog">Cancelar</button>
                <button class="tw-btn" style="background: var(--twenty-danger); color: white;" @onclick="ConfirmDelete">Excluir</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Aluno> alunos = new();
    private List<Aluno> filteredAlunos = new();
    private List<Turma> turmas = new();
    private Aluno editingAluno = new();
    private Aluno? alunoToDelete;
    private bool showDialog;
    private bool showDeleteDialog;
    private string searchText = "";
    private int filterTurmaId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            alunos = await db.Alunos.Include(a => a.Turma).OrderBy(a => a.Nome).ToListAsync();
            turmas = await db.Turmas.Where(t => t.Status == "Ativa").OrderBy(t => t.Nome).ToListAsync();
            FilterAlunos();
        }
        catch (Exception ex)
        {
            DebugService.CaptureError(ex, "Carregando alunos");
            Navigation.NavigateTo("/debug");
        }
    }

    private void FilterAlunos()
    {
        filteredAlunos = alunos.Where(a =>
            (string.IsNullOrEmpty(searchText) || a.Nome.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
            (filterTurmaId == 0 || a.TurmaId == filterTurmaId)
        ).ToList();
    }

    private void OpenCreateDialog()
    {
        editingAluno = new Aluno { DataMatricula = DateTime.Now, Status = "Ativo" };
        showDialog = true;
    }

    private void OpenEditDialog(Aluno a)
    {
        editingAluno = a;
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingAluno = new();
    }

    private void OpenDeleteDialog(Aluno a)
    {
        alunoToDelete = a;
        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        alunoToDelete = null;
    }

    private void ViewAluno(int id) => Navigation.NavigateTo($"/alunos/{id}");

    private async Task SaveAluno()
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            if (editingAluno.Id > 0)
                db.Alunos.Update(editingAluno);
            else
                db.Alunos.Add(editingAluno);
            await db.SaveChangesAsync();
            showDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            DebugService.CaptureError(ex, "Salvando aluno");
            Navigation.NavigateTo("/debug");
        }
    }

    private async Task ConfirmDelete()
    {
        try
        {
            if (alunoToDelete == null) return;
            using var db = await DbFactory.CreateDbContextAsync();
            var aluno = await db.Alunos.FindAsync(alunoToDelete.Id);
            if (aluno != null)
            {
                db.Alunos.Remove(aluno);
                await db.SaveChangesAsync();
            }
            showDeleteDialog = false;
            alunoToDelete = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            DebugService.CaptureError(ex, "Excluindo aluno");
            Navigation.NavigateTo("/debug");
        }
    }
}

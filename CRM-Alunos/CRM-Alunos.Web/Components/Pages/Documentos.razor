@page "/documentos"
@using CRM_Alunos.Web.Data
@using CRM_Alunos.Web.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDebugService DebugService
@inject NavigationManager Navigation

<PageTitle>Documentos - CRM Alunos</PageTitle>

<div class="tw-page-header">
    <h1 class="tw-page-title">Documentos</h1>
</div>

<div class="tw-table-container">
    <table class="tw-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Aluno</th>
                <th>Tamanho</th>
                <th>Data Upload</th>
                <th style="width: 60px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in documentos)
            {
                <tr>
                    <td style="font-weight: 500;">@doc.Nome</td>
                    <td><span class="tw-badge tw-badge-neutral">@doc.Tipo</span></td>
                    <td>@doc.Aluno?.Nome</td>
                    <td>@FormatSize(doc.Tamanho)</td>
                    <td>@doc.DataUpload.ToString("dd/MM/yyyy")</td>
                    <td>
                        <button class="tw-btn tw-btn-danger tw-btn-sm" @onclick="() => OpenDeleteDialog(doc)" title="Excluir">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!documentos.Any())
    {
        <div class="tw-empty">
            <svg class="tw-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <p>Nenhum documento encontrado</p>
        </div>
    }
</div>

@if (showDeleteDialog)
{
    <div class="tw-dialog-overlay" @onclick="CloseDeleteDialog">
        <div class="tw-dialog" style="width: 400px;" @onclick:stopPropagation="true">
            <div class="tw-dialog-header">Excluir Documento</div>
            <div class="tw-dialog-body">
                <p style="font-size: 13px; color: var(--twenty-text-secondary);">
                    Tem certeza que deseja excluir o documento <strong>@docToDelete?.Nome</strong>? Esta ação não pode ser desfeita.
                </p>
            </div>
            <div class="tw-dialog-footer">
                <button class="tw-btn tw-btn-secondary" @onclick="CloseDeleteDialog">Cancelar</button>
                <button class="tw-btn" style="background: var(--twenty-danger); color: white;" @onclick="ConfirmDelete">Excluir</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Documento> documentos = new();
    private Documento? docToDelete;
    private bool showDeleteDialog;

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        documentos = await db.Documentos.Include(d => d.Aluno).OrderByDescending(d => d.DataUpload).ToListAsync();
    }

    private void OpenDeleteDialog(Documento doc)
    {
        docToDelete = doc;
        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        docToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            if (docToDelete == null) return;
            using var db = await DbFactory.CreateDbContextAsync();
            var doc = await db.Documentos.FindAsync(docToDelete.Id);
            if (doc != null)
            {
                db.Documentos.Remove(doc);
                await db.SaveChangesAsync();
            }
            showDeleteDialog = false;
            docToDelete = null;
            documentos = await db.Documentos.Include(d => d.Aluno).OrderByDescending(d => d.DataUpload).ToListAsync();
        }
        catch (Exception ex)
        {
            DebugService.CaptureError(ex, "Excluindo documento");
            Navigation.NavigateTo("/debug");
        }
    }

    private string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1048576) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / 1048576.0).ToString("F1") + " MB";
    }
}

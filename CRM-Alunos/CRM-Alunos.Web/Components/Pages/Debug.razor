@page "/debug"
@using CRM_Alunos.Web.Services
@inject IDebugService DebugService
@inject NavigationManager Navigation

<PageTitle>CRM Alunos - Erro</PageTitle>

<div style="min-height: 100vh; background: #0d0d1a; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16px;">
    <div style="max-width: 700px; width: 100%; text-align: center;">
        <h1 style="color: #3d3d5c; font-size: 40px; font-weight: 700; letter-spacing: 0.15em; margin-bottom: 40px; user-select: none; font-family: 'DM Mono', 'Courier New', monospace;">
            CRM Alunos
        </h1>

        <h2 style="color: white; font-size: 22px; font-weight: 600; margin-bottom: 8px;">Algo deu errado</h2>
        <p style="color: #888; font-size: 14px; margin-bottom: 32px;">Ocorreu um erro ao carregar a aplicação.</p>

        @if (currentError != null)
        {
            <div style="background: #1a1a2e; border: 1px solid #2a2a4a; border-radius: 8px; padding: 20px; margin-bottom: 32px; text-align: left; position: relative;">
                <button @onclick="CopyError" style="position: absolute; top: 12px; right: 12px; background: none; border: none; color: #666; cursor: pointer; padding: 4px;" title="Copiar erro">
                    @if (copied)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    }
                </button>
                <pre style="color: #e0e0e0; font-size: 13px; white-space: pre-wrap; word-break: break-word; font-family: 'DM Mono', 'Courier New', monospace; line-height: 1.6; margin: 0;">@errorText</pre>
            </div>
        }

        <div style="display: flex; justify-content: center; gap: 12px; margin-bottom: 40px;">
            <button @onclick="Restart" style="padding: 10px 24px; background: transparent; border: 1px solid #444; color: white; border-radius: 8px; cursor: pointer; font-size: 13px; font-family: var(--twenty-font); transition: all 0.1s;" onmouseover="this.style.background='#222'; this.style.borderColor='#666'" onmouseout="this.style.background='transparent'; this.style.borderColor='#444'">
                Reiniciar
            </button>
            <button @onclick="ReportError" style="padding: 10px 24px; background: transparent; border: 1px solid #444; color: white; border-radius: 8px; cursor: pointer; font-size: 13px; font-family: var(--twenty-font); transition: all 0.1s;" onmouseover="this.style.background='#222'; this.style.borderColor='#666'" onmouseout="this.style.background='transparent'; this.style.borderColor='#444'">
                Reportar erro
            </button>
        </div>

        <p style="color: #888; font-size: 12px; margin-bottom: 8px;">
            Por favor, reporte este erro para a equipe do CRM Alunos
        </p>
        <p style="color: #666; font-size: 12px;">Versão: @version</p>
    </div>
</div>

@code {
    private string? errorText;
    private ErrorInfo? currentError;
    private bool copied;
    private string version = "1.0.0";

    protected override void OnInitialized()
    {
        version = DebugService.GetVersion();
        currentError = DebugService.GetCurrentError();
        if (currentError != null)
        {
            errorText = FormatError(currentError);
        }
    }

    private string FormatError(ErrorInfo error)
    {
        var lines = new List<string>();
        lines.Add($"{error.Type}: {error.Message}");
        if (!string.IsNullOrEmpty(error.StackTrace))
        {
            lines.Add("");
            lines.Add(error.StackTrace);
        }
        if (error.AdditionalData?.Count > 0)
        {
            lines.Add("");
            foreach (var kv in error.AdditionalData)
                lines.Add($"{kv.Key}: {kv.Value}");
        }
        return string.Join("\n", lines);
    }

    private async Task CopyError()
    {
        if (errorText != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", errorText);
            copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            copied = false;
            StateHasChanged();
        }
    }

    private void Restart()
    {
        DebugService.ClearError();
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void ReportError()
    {
        Navigation.NavigateTo("/", forceLoad: true);
    }

    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
}

@page "/debug"
@using CRM_Alunos.Web.Services
@inject IDebugService DebugService
@inject NavigationManager Navigation

<PageTitle>Debug - CRM Alunos</PageTitle>

<div class="tw-page-header">
    <h1 class="tw-page-title">Debug</h1>
    @if (errors.Any())
    {
        <button class="tw-btn tw-btn-danger tw-btn-sm" @onclick="ClearAll">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Limpar erros
        </button>
    }
</div>

@if (!errors.Any())
{
    <div class="tw-card" style="text-align: center; padding: 48px 24px;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--twenty-success)" stroke-width="1.5" style="margin: 0 auto 16px; opacity: 0.6;">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <h2 style="font-size: 16px; font-weight: 600; margin-bottom: 4px; color: var(--twenty-text-primary);">Tudo certo por aqui</h2>
        <p style="color: var(--twenty-text-tertiary); font-size: 13px;">Nenhum erro foi detectado na aplicação.</p>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 8px;">
        @foreach (var error in errors.AsEnumerable().Reverse())
        {
            <div class="tw-card" style="padding: 16px;">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;">
                    <div style="flex: 1; min-width: 0;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                            <span class="tw-badge tw-badge-danger">@error.Type</span>
                            <span style="font-size: 11px; color: var(--twenty-text-disabled); font-family: var(--twenty-font-mono);">@error.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</span>
                        </div>
                        <p style="font-size: 13px; font-weight: 500; margin-bottom: 4px; color: var(--twenty-text-primary);">@error.Message</p>
                        @if (!string.IsNullOrEmpty(error.StackTrace))
                        {
                            <pre style="font-size: 12px; font-family: var(--twenty-font-mono); color: var(--twenty-text-tertiary); background: var(--twenty-bg-secondary); padding: 8px 10px; border-radius: var(--twenty-radius-sm); margin-top: 8px; white-space: pre-wrap; word-break: break-all; max-height: 120px; overflow-y: auto;">@error.StackTrace</pre>
                        }
                        @if (error.AdditionalData?.Any() == true)
                        {
                            <div style="margin-top: 8px; display: flex; gap: 12px; flex-wrap: wrap;">
                                @foreach (var kv in error.AdditionalData)
                                {
                                    <span style="font-size: 12px; color: var(--twenty-text-tertiary);">
                                        <span style="font-weight: 500;">@kv.Key:</span> @kv.Value
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <button class="tw-btn tw-btn-ghost tw-btn-sm" @onclick="() => RemoveError(error)" style="flex-shrink: 0;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ErrorInfo> errors = new();

    protected override void OnInitialized()
    {
        errors = DebugService.GetAllErrors();
    }

    private void RemoveError(ErrorInfo error)
    {
        errors.Remove(error);
        StateHasChanged();
    }

    private void ClearAll()
    {
        DebugService.ClearError();
        errors.Clear();
        StateHasChanged();
    }
}

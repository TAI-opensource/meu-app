@page "/Error"
@using System.Diagnostics
@inject IDebugService DebugService
@inject NavigationManager Navigation

<PageTitle>CRM Alunos - Erro</PageTitle>

<div style="min-height: 100vh; background: var(--twenty-bg-secondary); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16px; font-family: var(--twenty-font);">
    <div style="max-width: 500px; width: 100%; text-align: center;">
        <div style="width: 48px; height: 48px; background: var(--twenty-bg-tertiary); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--twenty-danger)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>

        <h2 style="font-size: 18px; font-weight: 600; margin-bottom: 6px; color: var(--twenty-text-primary);">Algo deu errado</h2>
        <p style="color: var(--twenty-text-tertiary); font-size: 13px; margin-bottom: 24px;">Ocorreu um erro ao processar sua requisição.</p>

        @if (ShowRequestId)
        {
            <div style="background: var(--twenty-bg-primary); border: 1px solid var(--twenty-border); border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; text-align: left;">
                <span style="font-size: 12px; color: var(--twenty-text-tertiary); font-family: var(--twenty-font-mono);">RequestId: @RequestId</span>
            </div>
        }

        <button @onclick="Restart" class="tw-btn tw-btn-primary" style="margin-bottom: 16px;">
            Reiniciar
        </button>

        <p style="color: var(--twenty-text-disabled); font-size: 11px; font-family: var(--twenty-font-mono);">v@DebugService.GetVersion()</p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        if (!string.IsNullOrEmpty(RequestId))
        {
            DebugService.CaptureError("HttpRequestError", $"Request failed: {RequestId}");
        }
    }

    private void Restart()
    {
        DebugService.ClearError();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
